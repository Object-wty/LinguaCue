<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="LinguaCue.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="TextBoxDefaultCornerRadius">8</CornerRadius>
  </Application.Resources>

  <Application.Styles>
    <semi:SemiTheme Locale="zh-CN" />

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.62" />
    </Style>
    <Style Selector="Border.statusPill">
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,5" />
    </Style>
  </Application.Styles>
</Application>

